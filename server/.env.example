# ---------------------------------------------------------------------------
# EstateHub API configuration. Copy to .env and fill in real values.
# Never commit .env files.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Leave empty in development to use the embedded MongoDB (stored in MONGO_EMBEDDED_DB_PATH).
# Production example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/estatehub
MONGODB_URI=
MONGO_EMBEDDED_DB_PATH=.mongo-data

# Frontend URL (used in email links) and comma-separated CORS allowlist
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:5000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies: in production use COOKIE_SECURE=true. If the client and API are on different
# sites (e.g. vercel.app + onrender.com) also set COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
TRUST_PROXY=false

# Image uploads: "local" stores files in server/uploads, "cloudinary" uses Cloudinary
UPLOAD_MODE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=estatehub

# Email. Without SMTP_HOST, emails are printed to the server console and listed at
# GET /api/v1/dev/emails (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EstateHub <no-reply@estatehub.local>

BCRYPT_ROUNDS=12
# Seed demo data automatically when the development database is empty
AUTO_SEED=true
