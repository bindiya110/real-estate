# Base URL of the EstateHub API. In development "/api/v1" is proxied by Vite to the server.
# In production set the full URL, e.g. https://api.estatehub.example/api/v1
VITE_API_BASE_URL=/api/v1

# Origin of uploaded files served by the API (only needed when the API is on another domain)
VITE_ASSET_BASE_URL=

# Where the Vite dev proxy forwards /api requests
VITE_DEV_API_TARGET=http://localhost:5000
